#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PHP_BIN="$("$ROOT/scripts/find-php")"
COMPOSER_BIN="${COMPOSER_BIN:-$(command -v composer)}"

if [[ ! -f "$ROOT/vendor/autoload.php" ]]; then
  "$PHP_BIN" "$COMPOSER_BIN" install --no-interaction --working-dir "$ROOT"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required for interop tests (tests/server.ts)." >&2
  exit 1
fi

cd "$ROOT"
"$PHP_BIN" vendor/bin/phpunit -c phpunit.xml
