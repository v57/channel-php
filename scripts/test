#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PHP_BIN="${PHP_BIN:-/opt/homebrew/opt/php@8.3/bin/php}"
COMPOSER_BIN="${COMPOSER_BIN:-/opt/homebrew/bin/composer}"

if [[ ! -x "$PHP_BIN" ]]; then
  PHP_BIN="php"
fi

if [[ ! -f "$ROOT/vendor/autoload.php" ]]; then
  "$PHP_BIN" "$COMPOSER_BIN" install --no-interaction --working-dir "$ROOT"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required for interop tests (tests/server.ts)." >&2
  exit 1
fi

cd "$ROOT"
"$PHP_BIN" vendor/bin/phpunit -c phpunit.xml
