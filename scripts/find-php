#!/usr/bin/env bash
# Prints the first PHP binary that has ext-openswoole loaded: $PHP_BIN, then `php` on PATH.
set -euo pipefail

for candidate in "${PHP_BIN:-}" php; do
  [[ -z "$candidate" ]] && continue
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" --ri openswoole >/dev/null 2>&1; then
    echo "$candidate"
    exit 0
  fi
done

echo "No PHP with ext-openswoole found (set PHP_BIN; the Hub toolchain image has one)." >&2
exit 1
