{
  "name": "dimas/channel-php",
  "description": "PHP implementation of the Channel protocol",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-openswoole": "*"
  },
  "suggest": {
    "ext-simdjson": "Fast JSON decoder used by JsonCodec when available"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ChannelPhp\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "ChannelPhp\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
